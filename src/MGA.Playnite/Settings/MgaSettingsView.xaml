<UserControl x:Class="MGA.Playnite.Settings.MgaSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d1p1:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:d1p1="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="520" d:DesignWidth="620">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <TextBlock Text="1. Your MyGamesAnywhere server"
                       FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6"
                       Text="For example tv2:8900 or localhost:8900." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox Text="{Binding Settings.ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                         Width="360" Margin="0,0,8,0" />
                <Button Content="Find players"
                        Command="{Binding LoadProfilesCommand}"
                        Padding="12,4" />
            </StackPanel>

            <TextBlock Text="2. Sign in" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6"
                       Text="Choose your player and enter its password. Playnite does not keep the password: the server exchanges it for an access key that can only read your library and download your games, and you can revoke that key from the MGA console at any time." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="DisplayName"
                          Width="240" Margin="0,0,8,0" />
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Width="180" Margin="0,0,8,0" />
                <Button Content="Sign in"
                        Command="{Binding SignInCommand}"
                        Padding="12,4" />
            </StackPanel>

            <TextBlock Text="{Binding ConnectionStatus}"
                       TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" />

            <Button Content="Disconnect"
                    Command="{Binding DisconnectCommand}"
                    HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,16" />

            <TextBlock Text="Library" FontWeight="Bold" Margin="0,0,0,4" />
            <CheckBox Content="Download cover art, icons and backgrounds from MGA"
                      IsChecked="{Binding Settings.DownloadArtwork}"
                      Margin="0,0,0,8" />

            <CheckBox Content="Leave out games a subscription no longer carries"
                      IsChecked="{Binding Settings.HideLapsedSubscriptionGames}"
                      Margin="0,0,0,2" />
            <TextBlock TextWrapping="Wrap" Opacity="0.6" Margin="24,0,0,12"
                       Text="A subscription lists what an account has played, not what it owns, so it includes games that cannot be started today without buying them. Turning this off brings them back on the next library update." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Games per request" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding Settings.PageSize}" Width="80" />
            </StackPanel>

            <TextBlock Text="Downloads" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6"
                       Text="Where games downloaded from MGA are put. Leave blank to keep them beside Playnite's own data — games are large, so a drive with room is usually a better choice. Only games MGA holds the files for can be downloaded; Steam and Xbox games are opened in their own store." />
            <TextBox Text="{Binding Settings.InstallRoot, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8" />

            <TextBlock TextWrapping="Wrap" Opacity="0.6" Margin="0,8,0,0"
                       Text="Games that MyGamesAnywhere stops listing are tagged rather than deleted when they are installed on this machine, so nothing you have downloaded or played is removed without you asking." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
